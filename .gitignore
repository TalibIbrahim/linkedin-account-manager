# Default-deny: this repo is the skill template only. Nothing is tracked
# unless explicitly allowed below — so any personal file (state, leads,
# generated .pptx/.docx deliverables, screenshots, anything created while
# actually using the skill on a real account) is excluded automatically,
# including file types nobody thought to list here yet.
*

# Allow directories so git will look inside them
!/references/
!/scripts/

# Allow the actual skill template files
!/.gitignore
!/README.md
!/SKILL.md
!/references/**/*.md
!/scripts/**/*.py

# Re-exclude build/lock artifacts that could appear inside allowed dirs
**/__pycache__/
**/*.py[cod]
~$*
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
